{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "npm run vercel-build",
  "regions": ["fra1"],
  "functions": {
    "src/app/api/cron/videos/route.ts": { "maxDuration": 300, "memory": 2048 },
    "src/app/api/uploads/[...key]/route.ts": { "maxDuration": 60 }
  },
  "crons": [
    { "path": "/api/cron/promotions", "schedule": "0 * * * *" },
    { "path": "/api/cron/videos", "schedule": "*/5 * * * *" },
    { "path": "/api/cron/cleanup", "schedule": "30 3 * * *" }
  ]
}
