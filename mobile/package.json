{
  "name": "nazlawi-mobile",
  "version": "1.0.0",
  "private": true,
  "description": "Capacitor Android shell for Nazlawi (loads the server-rendered web app from CAP_SERVER_URL)",
  "scripts": {
    "assets": "node scripts/make-assets.mjs && capacitor-assets generate --android --iconBackgroundColor '#D4704A' --iconBackgroundColorDark '#D4704A' --splashBackgroundColor '#FBF3EA' --splashBackgroundColorDark '#2B1D16'",
    "sync": "cap sync android",
    "sync:dev": "CAP_MODE=dev cap sync android",
    "apk:debug": "cap sync android && cd android && ./gradlew assembleDebug",
    "apk:debug:dev": "CAP_MODE=dev cap sync android && cd android && ./gradlew assembleDebug",
    "bundle:release": "cap sync android && cd android && ./gradlew bundleRelease",
    "open": "cap open android"
  },
  "dependencies": {
    "@capacitor/android": "8.5.3",
    "@capacitor/app": "8.1.2",
    "@capacitor/core": "8.5.3",
    "@capacitor/push-notifications": "8.1.3",
    "@capacitor/splash-screen": "8.0.2",
    "@capacitor/status-bar": "8.0.4"
  },
  "devDependencies": {
    "@capacitor/assets": "3.0.5",
    "@capacitor/cli": "8.5.3",
    "sharp": "^0.35.5",
    "typescript": "5.9.3"
  },
  "overrides": {
    "tar": "^7.5.18",
    "uuid": "^11.1.1",
    "sharp": "^0.35.5"
  }
}
