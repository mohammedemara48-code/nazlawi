// PostgreSQL (local Postgres in dev/tests, Neon / Vercel Postgres in production).
// DATABASE_URL = pooled connection for the app; DIRECT_URL = direct (non-pooled) connection for migrations.
// Statuses/roles are strings (validated with Zod) so new values need no migration.
generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["omitApi"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                  String        @id @default(cuid())
  name                String
  email               String        @unique
  password            String
  role                String        @default("RESIDENT") // RESIDENT | PROVIDER | ADMIN
  emailVerified       DateTime?
  phone               String?
  // Optional home location (resident address) picked on a map + short landmark.
  latitude            Float?
  longitude           Float?
  addressNote         String        @default("")
  locale              String        @default("ar") // preferred language: ar | en
  status              String        @default("ACTIVE") // ACTIVE | SUSPENDED
  sessionVersion      Int           @default(0) // bump to invalidate all existing sessions
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
  stores              Store[] // one store per provider for now (enforced in the service layer)
  listings            Listing[]
  tokens              AuthToken[]
  auditLogs           AuditLog[]
  promotionsRequested Promotion[]
  avatarKey           String? // profile photo (WebP, 400x400)
  posts               Post[]
  postComments        PostComment[]
  postLikes           PostLike[]
  postReports         PostReport[]

  @@index([role, status])
  @@index([createdAt])
}

/// A provider's mini store. Goes through admin approval like listings.
model Store {
  id          String         @id @default(cuid())
  slug        String         @unique
  ownerId     String
  owner       User           @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  category    String // groceries|clothing|construction|rides|transport|medical
  subcategory String? // medical: doctors|pharmacies|labs; crafts: electrician|plumber|carpenter|plastering|gypsum|other_craft
  craftName   String         @default("") // crafts + other_craft: the provider's own craft name
  nameAr      String
  nameEn      String
  bioAr       String         @default("")
  bioEn       String         @default("")
  phone       String
  whatsapp    String?
  addressAr   String         @default("")
  addressEn   String         @default("")
  area        String         @default("")
  openTime    String? // "HH:MM" (Africa/Cairo), null = hours not set
  closeTime   String?
  hoursNoteAr String         @default("")
  hoursNoteEn String         @default("")
  latitude    Float?
  longitude   Float?
  logoKey     String?
  coverKey    String?
  status      String         @default("PENDING") // PENDING | APPROVED | HIDDEN
  deletedAt   DateTime? // soft delete by admin: hidden everywhere, purged after 30 days
  isExample   Boolean        @default(false)
  searchText  String         @default("")
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  listings    Listing[]
  groups      ListingGroup[]
  video       Video?
  promotions  Promotion[]

  @@index([status, category, subcategory])
  @@index([ownerId])
  @@index([searchText])
  @@index([deletedAt])
}

/// Provider-defined sections inside a store (e.g. "Vegetables", "Offers").
model ListingGroup {
  id        String    @id @default(cuid())
  storeId   String
  store     Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  nameAr    String
  nameEn    String
  position  Int       @default(0)
  listings  Listing[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @default(now()) @updatedAt

  @@index([storeId, position])
}

/// An ad/offer that belongs to a store.
model Listing {
  id               String         @id @default(cuid())
  storeId          String?
  store            Store?         @relation(fields: [storeId], references: [id], onDelete: Cascade)
  groupId          String?
  group            ListingGroup?  @relation(fields: [groupId], references: [id], onDelete: SetNull)
  category         String // copied from the store
  subcategory      String?
  nameAr           String
  nameEn           String
  descAr           String         @default("")
  descEn           String         @default("")
  phone            String
  whatsapp         String?
  available        Boolean        @default(true)
  // Price: integer minor units (piasters) to avoid float errors.
  priceType        String         @default("ON_REQUEST") // FIXED | FROM | NEGOTIABLE | ON_REQUEST
  priceMinor       Int? // required for FIXED / FROM
  oldPriceMinor    Int? // optional "before" price for offers; must be > priceMinor
  currency         String         @default("EGP")
  unitAr           String         @default("") // e.g. "للكيلو"
  unitEn           String         @default("") // e.g. "per kg"
  unit             String? // product unit code: piece|kg|gram|liter|box|carton|pack|dozen (labels in i18n)
  position         Int            @default(0) // order inside its section (merchant-defined)
  status           String         @default("PENDING") // PENDING | APPROVED | HIDDEN
  featuredPosition Int? // 1..3 when featured on the store, null otherwise
  deletedAt        DateTime? // soft delete by admin: hidden everywhere, purged after 30 days
  // Optional own location (e.g. pickup point / service area) + short landmark; defaults to the store's.
  latitude         Float?
  longitude        Float?
  locationNote     String         @default("")
  isExample        Boolean        @default(false)
  searchText       String         @default("")
  ownerId          String?
  owner            User?          @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  images           ListingImage[]
  video            Video?
  promotions       Promotion[]

  @@index([status, category, subcategory])
  @@index([storeId, status, featuredPosition])
  @@index([storeId, groupId, position])
  @@index([storeId, status, priceMinor])
  @@index([category, status, priceMinor])
  @@index([ownerId])
  @@index([searchText])
  @@index([deletedAt])
}

model ListingImage {
  id        String   @id @default(cuid())
  listingId String
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  key       String   @unique
  width     Int
  height    Int
  position  Int      @default(0)
  createdAt DateTime @default(now())

  @@index([listingId, position])
}

/// One promo video per listing and/or per store. Private until approved.
model Video {
  id          String     @id @default(cuid())
  listingId   String?    @unique
  listing     Listing?   @relation(fields: [listingId], references: [id], onDelete: Cascade)
  storeId     String?    @unique
  store       Store?     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  ownerId     String
  sourceKey   String?    @unique // original upload, deleted after processing
  key         String?    @unique // transcoded mp4 (null until processed)
  posterKey   String?    @unique // webp poster (null until processed)
  durationSec Float      @default(0)
  width       Int        @default(0)
  height      Int        @default(0)
  sizeBytes   Int        @default(0)
  status      String     @default("PENDING") // moderation: PENDING | APPROVED | REJECTED
  processing  String     @default("QUEUED") // QUEUED | PROCESSING | READY | FAILED
  error       String? // error code when processing FAILED (VIDEO_INVALID, VIDEO_TOO_LONG, ...)
  isExample   Boolean    @default(false)
  createdAt   DateTime   @default(now())
  jobs        VideoJob[]

  @@index([status, createdAt])
  @@index([processing])
}

/// Background transcoding job (worker process or cron endpoint).
model VideoJob {
  id          String    @id @default(cuid())
  videoId     String
  video       Video     @relation(fields: [videoId], references: [id], onDelete: Cascade)
  status      String    @default("PENDING") // PENDING | PROCESSING | DONE | FAILED
  attempts    Int       @default(0)
  maxAttempts Int       @default(3)
  runAfter    DateTime  @default(now())
  lockedAt    DateTime?
  lastError   String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([status, runAfter])
  @@index([videoId])
}

/// Promoted offer shown in the "عروض مميزة" strip.
model Promotion {
  id            String   @id @default(cuid())
  targetType    String // LISTING | STORE
  listingId     String?
  listing       Listing? @relation(fields: [listingId], references: [id], onDelete: Cascade)
  storeId       String
  store         Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  category      String // copied from the store, for per-category strips
  startsAt      DateTime
  endsAt        DateTime
  priority      Int      @default(0) // higher first
  status        String   @default("PENDING") // PENDING | APPROVED | REJECTED | EXPIRED
  note          String   @default("")
  isExample     Boolean  @default(false)
  requestedById String?
  requestedBy   User?    @relation(fields: [requestedById], references: [id], onDelete: SetNull)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([status, startsAt, endsAt, priority])
  @@index([category, status])
  @@index([storeId])
}

/// Single-use, expiring tokens. Only a SHA-256 hash of the token is stored.
model AuthToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String // VERIFY_EMAIL | RESET_PASSWORD | CHANGE_EMAIL
  data      String?
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, type])
}

/// Append-only log of admin actions.
model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  actorEmail String
  action     String
  targetType String // USER | LISTING | STORE | VIDEO | PROMOTION
  targetId   String
  meta       String   @default("{}")
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([targetType, targetId])
}

/// Event invitations timeline (دعوات المناسبات): residents post an image + caption; village users like/comment.
/// Deletion (by the author or an admin) is permanent: rows cascade and the image file is removed.
model Post {
  id        String        @id @default(cuid())
  authorId  String
  author    User          @relation(fields: [authorId], references: [id], onDelete: Cascade)
  imageKey  String        @unique
  width     Int
  height    Int
  caption   String        @default("")
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  comments  PostComment[]
  likes     PostLike[]
  reports   PostReport[]

  @@index([createdAt])
  @@index([authorId, createdAt])
}

model PostComment {
  id        String       @id @default(cuid())
  postId    String
  post      Post         @relation(fields: [postId], references: [id], onDelete: Cascade)
  authorId  String
  author    User         @relation(fields: [authorId], references: [id], onDelete: Cascade)
  body      String
  createdAt DateTime     @default(now())
  reports   PostReport[]

  @@index([postId, createdAt])
  @@index([authorId])
}

model PostLike {
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([postId, userId])
  @@index([userId])
}

/// A user's report on a post or a comment (one per reporter per target). Admin reviews in /admin/reports.
model PostReport {
  id         String       @id @default(cuid())
  reporterId String
  reporter   User         @relation(fields: [reporterId], references: [id], onDelete: Cascade)
  postId     String?
  post       Post?        @relation(fields: [postId], references: [id], onDelete: Cascade)
  commentId  String?
  comment    PostComment? @relation(fields: [commentId], references: [id], onDelete: Cascade)
  reason     String       @default("")
  createdAt  DateTime     @default(now())

  @@unique([reporterId, postId])
  @@unique([reporterId, commentId])
  @@index([createdAt])
}
