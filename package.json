{
  "name": "nazlawi",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3100",
    "build": "prisma generate && next build",
    "start": "next start -p 3100",
    "db:seed": "tsx prisma/seed.ts",
    "test": "vitest run",
    "screenshots": "PW_EXPERIMENTAL_SERVICE_WORKER_NETWORK_EVENTS=1 tsx scripts/screenshots.ts",
    "vercel-build": "node scripts/vercel-build.mjs",
    "postinstall": "prisma generate",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "worker": "tsx scripts/video-worker.ts",
    "smoke": "node --env-file=.env scripts/smoke.mjs",
    "predeploy": "npm run typecheck && npm run lint && npm test && npm run smoke",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@prisma/client": "5.22.0",
    "@upstash/redis": "^1.39.0",
    "@vercel/blob": "^2.8.2",
    "bcryptjs": "2.4.3",
    "ioredis": "^5.11.1",
    "jose": "5.9.6",
    "leaflet": "1.9",
    "next": "^15.5.28",
    "nodemailer": "^6.10.1",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "sharp": "^0.35.5",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@types/bcryptjs": "2.4.6",
    "@types/leaflet": "^1.9.22",
    "@types/node": "20.17.10",
    "@types/nodemailer": "^6.4.24",
    "@types/react": "19.0.7",
    "@types/react-dom": "19.0.3",
    "autoprefixer": "10.4.20",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.6",
    "playwright": "1.49.1",
    "postcss": "8.4.49",
    "prettier": "^3.9.10",
    "prisma": "5.22.0",
    "tailwindcss": "3.4.17",
    "tsx": "4.19.2",
    "typescript": "5.7.3",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=20"
  }
}
