# ---------------------------------------------------------------------------
# Nazlawi environment. Copy to .env (local) or add in Vercel → Project → Settings → Environment Variables.
# Never commit real values.
# ---------------------------------------------------------------------------

# --- Database (PostgreSQL) — REQUIRED ---
# Local: postgresql://nazlawi:nazlawi@localhost:5432/nazlawi
# Neon / Vercel Postgres: DATABASE_URL = pooled URL (host contains "-pooler", add ?sslmode=require&pgbouncer=true&connect_timeout=15)
#                         DIRECT_URL   = direct (non-pooled) URL, used by `prisma migrate deploy`
DATABASE_URL="postgresql://nazlawi:nazlawi@localhost:5432/nazlawi"
DIRECT_URL="postgresql://nazlawi:nazlawi@localhost:5432/nazlawi"
# Tests only (must end in _test; it is reset on every run)
TEST_DATABASE_URL="postgresql://nazlawi:nazlawi@localhost:5432/nazlawi_test"

# --- Auth — REQUIRED ---
# Generate with: openssl rand -base64 32
AUTH_SECRET="change-me-to-a-long-random-string"
# Public base URL used in email links (production: https://your-domain)
APP_URL="http://localhost:3100"

# --- Storage — REQUIRED in production ---
# local       = files under UPLOAD_DIR (dev/tests only; Vercel's filesystem is not persistent)
# vercel-blob = private Vercel Blob store; browsers upload directly with short-lived tokens
STORAGE_DRIVER="local"
UPLOAD_DIR="uploads"
# Set automatically when you connect a Blob store to the Vercel project:
BLOB_READ_WRITE_TOKEN=""

# --- Rate limiting (Upstash Redis) — recommended in production ---
# Either the Upstash names or the KV_* names the Vercel Marketplace integration creates.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
KV_REST_API_URL=""
KV_REST_API_TOKEN=""
# Alternative: plain Redis over TCP (self-hosted worker/server)
REDIS_URL=""

# --- Cron — REQUIRED in production ---
# Vercel sends "Authorization: Bearer $CRON_SECRET" to /api/cron/*. Generate: openssl rand -hex 32
CRON_SECRET=""

# --- Video processing ---
VIDEO_MAX_MB="50"
VIDEO_MAX_SECONDS="60"
# Optional custom binaries (e.g. ffmpeg-static on Vercel); defaults to ffmpeg/ffprobe on PATH
FFMPEG_PATH=""
FFPROBE_PATH=""
# Worker poll interval (ms) for `npm run worker`
WORKER_POLL_MS="5000"

# --- Email (SMTP) — REQUIRED in production for verification/reset emails ---
# Empty SMTP_HOST in dev -> emails are saved to .outbox/ (see /dev/outbox)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="Nazlawi <no-reply@nazlawi.example>"

# --- Android app (mobile/) ---
# Start FCM push registration inside the Android app. Keep "0" until a Firebase project exists and the APK
# ships with android/app/google-services.json (see ANDROID.md); registering without it crashes the app.
NEXT_PUBLIC_PUSH_ENABLED="0"
